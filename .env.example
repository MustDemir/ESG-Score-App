# Kopiere zu .env (wird via .gitignore ignoriert)

# --- Supabase (EU Central / Frankfurt) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # nur server-side, NIE in Flutter-App

# --- Open Food Facts ---
# Pflicht laut OFF-Policy: identifizierender User-Agent
OPENFOODFACTS_USER_AGENT=ScanFair/0.1 (business.demir@gmail.com)

# --- App ---
APP_ENV=dev
